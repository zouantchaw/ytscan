{
  "name": "ytscan",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare-native backend and ingestion workspace for YouTube content intelligence.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "deploy": "npm run deploy --workspace=apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:artifacts": "tsx packages/scripts/src/ingest/build-channel-artifacts.ts",
    "vectorize:upsert": "tsx packages/scripts/src/vectorize/upsert-transcript-chunks.ts",
    "scan:run": "tsx packages/scripts/src/scan/run-scan-jobs.ts",
    "media:run": "tsx packages/scripts/src/generation/run-generation-jobs.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.43.0"
  },
  "engines": {
    "node": ">=23.5.0"
  }
}
