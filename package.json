{
  "name": "ytscan",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare-native backend and ingestion workspace for YouTube content intelligence.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "PATH=/usr/local/opt/node/bin:$PATH npm --prefix apps/web run dev",
    "dev:api": "PATH=/usr/local/opt/node/bin:$PATH npm --prefix apps/api run dev",
    "build:web": "PATH=/usr/local/opt/node/bin:$PATH npm --prefix apps/web run build",
    "lint:web": "PATH=/usr/local/opt/node/bin:$PATH npm --prefix apps/web run lint",
    "deploy": "PATH=/usr/local/opt/node/bin:$PATH npm --prefix apps/api run deploy",
    "typecheck": "PATH=/usr/local/opt/node/bin:$PATH npm --prefix apps/web run typecheck && PATH=/usr/local/opt/node/bin:$PATH npm --prefix apps/api run typecheck && PATH=/usr/local/opt/node/bin:$PATH npm --prefix packages/core run typecheck && PATH=/usr/local/opt/node/bin:$PATH npm --prefix packages/scripts run typecheck",
    "build:artifacts": "tsx packages/scripts/src/ingest/build-channel-artifacts.ts",
    "vectorize:upsert": "tsx packages/scripts/src/vectorize/upsert-transcript-chunks.ts",
    "scan:run": "tsx packages/scripts/src/scan/run-scan-jobs.ts",
    "media:run": "tsx packages/scripts/src/generation/run-generation-jobs.ts",
    "worker:run": "tsx packages/scripts/src/workers/run-background-workers.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.43.0"
  },
  "engines": {
    "node": ">=23.5.0"
  }
}
